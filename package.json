{
  "name": "lehrerkompass-machbarkeit",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:graph:personal": "tsx prototypes/onedrive/src/personal-graph-smoke.ts",
    "artifacts": "tsx prototypes/documents/src/generate.ts && tsx prototypes/library-index/src/generate-fixtures.ts",
    "prototype": "vite --host 127.0.0.1",
    "check": "pnpm artifacts && pnpm build && pnpm test"
  },
  "dependencies": {
    "dexie": "^4.2.1",
    "docx": "^9.5.1",
    "pdfkit": "^0.17.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/pdfkit": "^0.17.3",
    "@vitest/coverage-v8": "^4.0.15",
    "fake-indexeddb": "^6.2.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^4.0.15"
  },
  "packageManager": "pnpm@11.7.0"
}
