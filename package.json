{
  "name": "lehrerkompass-machbarkeit",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "build": "pnpm typecheck && vite build --config apps/web/vite.config.ts",
    "test": "vitest run",
    "test:a11y": "vitest run apps/web/src/test/accessibility.test.tsx apps/web/src/test/app-accessibility.test.tsx apps/web/src/features/workbench/tests/workbench-accessibility.test.tsx apps/web/src/features/classes/tests/classes-accessibility.test.tsx apps/web/src/features/series/series-accessibility.test.tsx apps/web/src/features/lessons/lessons-accessibility.test.tsx apps/web/src/features/calendar/calendar-accessibility.test.tsx apps/web/src/features/materials/materials-accessibility.test.tsx apps/web/src/features/buddy/buddy-accessibility.test.tsx apps/web/src/features/server/server-accessibility.test.tsx",
    "test:coverage": "vitest run --coverage",
    "test:graph:personal": "tsx prototypes/onedrive/src/personal-graph-smoke.ts",
    "artifacts": "tsx prototypes/documents/src/generate.ts && tsx prototypes/library-index/src/generate-fixtures.ts",
    "prototype": "vite --host 127.0.0.1",
    "design-system": "vite --config apps/web/vite.config.ts --host 127.0.0.1",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm test:a11y",
    "api": "tsx apps/api/src/server.ts",
    "test:api": "vitest run apps/api/tests/api.test.ts",
    "test:integration": "vitest run apps/api/tests/db.integration.test.ts",
    "test:security": "vitest run apps/api/tests/security.test.ts apps/api/tests/api.test.ts",
    "test:db-migrations": "vitest run apps/api/tests/db.integration.test.ts",
    "test:secret-scan": "vitest run apps/api/tests/security.test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.1",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/rate-limit": "^11.1.0",
    "@prisma/client": "6.19.0",
    "dexie": "^4.2.1",
    "docx": "^9.5.1",
    "fastify": "^5.10.0",
    "jose": "^6.2.3",
    "lucide-react": "^1.24.0",
    "openai": "^6.46.0",
    "pdfkit": "^0.17.2",
    "pg": "^8.22.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.1",
    "@types/pdfkit": "^0.17.3",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.0.15",
    "axe-core": "^4.12.1",
    "embedded-postgres": "18.4.0-beta.17",
    "fake-indexeddb": "^6.2.4",
    "jsdom": "^29.1.1",
    "prisma": "6.19.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^4.0.15"
  },
  "packageManager": "pnpm@11.7.0"
}
