{
  "name": "lehrerkompass-machbarkeit",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "build": "pnpm typecheck && vite build --config apps/web/vite.config.ts",
    "test": "vitest run",
    "test:a11y": "vitest run apps/web/src/test/accessibility.test.tsx apps/web/src/test/app-accessibility.test.tsx apps/web/src/features/workbench/tests/workbench-accessibility.test.tsx apps/web/src/features/classes/tests/classes-accessibility.test.tsx",
    "test:coverage": "vitest run --coverage",
    "test:graph:personal": "tsx prototypes/onedrive/src/personal-graph-smoke.ts",
    "artifacts": "tsx prototypes/documents/src/generate.ts && tsx prototypes/library-index/src/generate-fixtures.ts",
    "prototype": "vite --host 127.0.0.1",
    "design-system": "vite --config apps/web/vite.config.ts --host 127.0.0.1",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm test:a11y"
  },
  "dependencies": {
    "dexie": "^4.2.1",
    "docx": "^9.5.1",
    "lucide-react": "^1.24.0",
    "pdfkit": "^0.17.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.1",
    "@types/pdfkit": "^0.17.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.0.15",
    "axe-core": "^4.12.1",
    "fake-indexeddb": "^6.2.4",
    "jsdom": "^29.1.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^4.0.15"
  },
  "packageManager": "pnpm@11.7.0"
}
